# TenPin Asset Generation API Keys
# Copy this file to .env and fill in your API keys.

# OpenAI — for DALL-E 3 concept image generation
OPENAI_API_KEY=

# Meshy — for image-to-3D model generation (https://www.meshy.ai)
MESHY_API_KEY=

# ElevenLabs — for sound effect and voice generation (optional)
ELEVENLABS_API_KEY=
